+bool NeuronDelegateKernel::RestoreDla(const std::string& dir,
+                                      const std::string& key) {
+  const std::string path = NpusttDlaPath(dir, key);
+  const long long t0 = NpusttNowMs();
+  NpusttMappedFile file;
+  int code = file.Map(path);
+  if (code == -ENOENT) {
+    TFLITE_LOG_PROD(tflite::TFLITE_LOG_INFO,
+                    "npustt: dla restore key=%s result=miss", key.c_str());
+    return false;
+  }
+  NeuronModel* model = nullptr;
+  NeuronCompilation* compilation = nullptr;
+  if (code == 0) {
+    code = neuronapi_->NeuronModel_restoreFromCompiledNetwork(
+        &model, &compilation, file.data(), file.size());
+    if (code == NEURON_NO_ERROR && (model == nullptr || compilation == nullptr)) {
+      if (compilation != nullptr) neuronapi_->NeuronCompilation_free(compilation);
+      if (model != nullptr) neuronapi_->NeuronModel_free(model);
+      code = -EFAULT;
+    }
+  }
+  if (code != 0) {
+    // Negative codes are -errno from open/fstat/mmap, positive ones Neuron's.
+    // On a Neuron error nothing is freed: the adapter keeps what it created.
+    TFLITE_LOG_PROD(tflite::TFLITE_LOG_INFO,
+                    "npustt: dla restore key=%s result=fail code=%d",
+                    key.c_str(), code);
+    file.Reset();
+    unlink(path.c_str());
+    return false;
+  }
+  // Replaces (frees) the model built in Init; its weights were never compiled.
+  nn_model_.reset(model);
+  nn_compilation_.reset(compilation);
+  file.ReleasePages();
+  dla_file_ = std::move(file);
+  TFLITE_LOG_PROD(tflite::TFLITE_LOG_INFO,
+                  "npustt: dla restore key=%s result=hit bytes=%zu ms=%lld",
+                  key.c_str(), dla_file_.size(), NpusttNowMs() - t0);
+  return true;
+}
+
+void NeuronDelegateKernel::StoreDla(const std::string& dir,
+                                    const std::string& key) {
+  const long long t0 = NpusttNowMs();
+  size_t size = 0;
+  int code = neuronapi_->NeuronCompilation_getCompiledNetworkSize(
+      nn_compilation_.get(), &size);
+  if (code != NEURON_NO_ERROR || size == 0) {
+    TFLITE_LOG_PROD(tflite::TFLITE_LOG_INFO,
+                    "npustt: dla store key=%s result=fail code=%d stage=size",
+                    key.c_str(), code != NEURON_NO_ERROR ? code : -EINVAL);
+    return;
+  }
+  // Transient: one buffer at a time, freed before the next partition compiles.
+  void* buffer = std::malloc(size);
+  const char* stage = "store";
+  if (buffer == nullptr) {
+    code = -ENOMEM;
+  } else {
+    code = neuronapi_->NeuronCompilation_storeCompiledNetwork(
+        nn_compilation_.get(), buffer, size);
+    if (code == NEURON_NO_ERROR) {
+      stage = "write";
+      code = NpusttWriteFileAtomic(dir, key, buffer, size);
+    }
+    std::free(buffer);
+  }
+  if (code != 0) {
+    TFLITE_LOG_PROD(tflite::TFLITE_LOG_INFO,
+                    "npustt: dla store key=%s result=fail code=%d stage=%s",
+                    key.c_str(), code, stage);
+    return;
+  }
+  TFLITE_LOG_PROD(tflite::TFLITE_LOG_INFO,
+                  "npustt: dla store key=%s result=ok bytes=%zu ms=%lld",
+                  key.c_str(), size, NpusttNowMs() - t0);
+}
