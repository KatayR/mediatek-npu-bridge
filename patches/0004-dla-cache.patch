diff --git a/neuron/npustt_dla_cache.h b/neuron/npustt_dla_cache.h
new file mode 100644
index 0000000..e14a2ca
--- /dev/null
+++ b/neuron/npustt_dla_cache.h
@@ -0,0 +1,230 @@
+/*
+ * npu-stt patch 0004 (MIT, like the delegate it extends): compiled-network
+ * ("DLA") cache. Pure helpers, no Neuron calls, so they can be unit-tested on
+ * the host: cache key, paths, mkdir -p, tmp-then-rename write, read-only mmap.
+ */
+#ifndef NEURON_NPUSTT_DLA_CACHE_H_
+#define NEURON_NPUSTT_DLA_CACHE_H_
+
+#include <errno.h>
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace tflite {
+namespace neuron {
+
+// DLA mode is asked for when both cache_dir and model_token are non-empty.
+inline bool NpusttDlaRequested(const char* cache_dir, const char* model_token) {
+  return cache_dir != nullptr && cache_dir[0] != '\0' &&
+         model_token != nullptr && model_token[0] != '\0';
+}
+
+// Name of the first missing adapter symbol, or nullptr when all three exist.
+inline const char* NpusttDlaMissingSymbol(bool has_get_size, bool has_store,
+                                          bool has_restore) {
+  if (!has_get_size) return "NeuronCompilation_getCompiledNetworkSize";
+  if (!has_store) return "NeuronCompilation_storeCompiledNetwork";
+  if (!has_restore) return "NeuronModel_restoreFromCompiledNetwork";
+  return nullptr;
+}
+
+inline std::string NpusttVersionString(int major, int minor, int patch) {
+  char buf[32];
+  std::snprintf(buf, sizeof(buf), "%d.%d.%d", major, minor, patch);
+  return buf;
+}
+
+// FNV-1a 64-bit. Every field is followed by its length (8 bytes, LE) so that
+// moving bytes between neighbouring fields changes the key.
+class NpusttFnv1a64 {
+ public:
+  void Bytes(const void* data, size_t size) {
+    const uint8_t* p = static_cast<const uint8_t*>(data);
+    for (size_t i = 0; i < size; ++i) {
+      hash_ ^= p[i];
+      hash_ *= 0x100000001b3ULL;
+    }
+  }
+  void Field(const void* data, size_t size) {
+    Bytes(data, size);
+    uint8_t len[8];
+    for (int i = 0; i < 8; ++i) len[i] = static_cast<uint8_t>(size >> (8 * i));
+    Bytes(len, sizeof(len));
+  }
+  void Field(const char* s) { Field(s, s == nullptr ? 0 : std::strlen(s)); }
+  uint64_t value() const { return hash_; }
+
+ private:
+  uint64_t hash_ = 0xcbf29ce484222325ULL;
+};
+
+// 16 lowercase hex chars over the inputs listed in notes/spec-dla-cache.md.
+inline std::string NpusttDlaKey(const std::vector<uint8_t>& graph_token,
+                                const char* accelerator_name,
+                                const char* builtin_compile_args,
+                                const char* compile_options, bool allow_fp16,
+                                const std::string& neuron_version) {
+  NpusttFnv1a64 h;
+  h.Field(graph_token.data(), graph_token.size());
+  h.Field(accelerator_name);
+  h.Field(builtin_compile_args);
+  h.Field(compile_options);
+  const uint8_t fp16 = allow_fp16 ? 1 : 0;
+  h.Field(&fp16, 1);
+  h.Field(neuron_version.c_str());
+  h.Field("0004");
+  char buf[17];
+  std::snprintf(buf, sizeof(buf), "%016llx",
+                static_cast<unsigned long long>(h.value()));
+  return buf;
+}
+
+// <cache_dir>/npustt-dla/<model_token>; characters other than [A-Za-z0-9._-]
+// in the token become '_' (an MD5 hex token is kept as it is), so a token can
+// never leave the cache directory.
+inline std::string NpusttDlaDir(const char* cache_dir, const char* model_token) {
+  std::string dir = cache_dir;
+  while (dir.size() > 1 && dir.back() == '/') dir.pop_back();
+  std::string token = model_token;
+  for (auto& c : token) {
+    const bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+                    (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.';
+    if (!ok) c = '_';
+  }
+  if (token == "." || token == "..") token = "_";
+  return dir + "/npustt-dla/" + token;
+}
+
+inline std::string NpusttDlaPath(const std::string& dir, const std::string& key,
+                                 const char* suffix = ".dla") {
+  return dir + "/" + key + suffix;
+}
+
+// mkdir -p; 0 or -errno.
+inline int NpusttMakeDirs(const std::string& path) {
+  for (size_t pos = 1; pos <= path.size(); ++pos) {
+    if (pos != path.size() && path[pos] != '/') continue;
+    const std::string part = path.substr(0, pos);
+    if (mkdir(part.c_str(), 0755) != 0 && errno != EEXIST) return -errno;
+  }
+  struct stat st;
+  if (stat(path.c_str(), &st) != 0) return -errno;
+  return S_ISDIR(st.st_mode) ? 0 : -ENOTDIR;
+}
+
+// Writes buf to <dir>/<key>.tmp (fsync) and renames it to <dir>/<key>.dla,
+// creating dir first. 0 or -errno; the .tmp file is removed on failure.
+inline int NpusttWriteFileAtomic(const std::string& dir, const std::string& key,
+                                 const void* buf, size_t size) {
+  int rc = NpusttMakeDirs(dir);
+  if (rc != 0) return rc;
+  const std::string tmp = NpusttDlaPath(dir, key, ".tmp");
+  const int fd = open(tmp.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+  if (fd < 0) return -errno;
+  const uint8_t* p = static_cast<const uint8_t*>(buf);
+  size_t left = size;
+  while (left > 0 && rc == 0) {
+    const ssize_t n = write(fd, p, left);
+    if (n < 0 && errno == EINTR) continue;
+    if (n <= 0) {
+      rc = n < 0 ? -errno : -EIO;
+      break;
+    }
+    p += n;
+    left -= static_cast<size_t>(n);
+  }
+  if (rc == 0 && fsync(fd) != 0) rc = -errno;
+  if (close(fd) != 0 && rc == 0) rc = -errno;
+  if (rc == 0 && rename(tmp.c_str(), NpusttDlaPath(dir, key).c_str()) != 0) {
+    rc = -errno;
+  }
+  if (rc != 0) unlink(tmp.c_str());
+  return rc;
+}
+
+// Read-only private mapping of a whole file, unmapped by the destructor.
+class NpusttMappedFile {
+ public:
+  NpusttMappedFile() = default;
+  NpusttMappedFile(const NpusttMappedFile&) = delete;
+  NpusttMappedFile& operator=(const NpusttMappedFile&) = delete;
+  NpusttMappedFile(NpusttMappedFile&& o) noexcept { *this = std::move(o); }
+  NpusttMappedFile& operator=(NpusttMappedFile&& o) noexcept {
+    if (this != &o) {
+      Reset();
+      data_ = o.data_;
+      size_ = o.size_;
+      o.data_ = nullptr;
+      o.size_ = 0;
+    }
+    return *this;
+  }
+  ~NpusttMappedFile() { Reset(); }
+
+  // 0, -ENOENT when the file does not exist, or another -errno (an empty
+  // file gives -EINVAL). The descriptor is closed again right away.
+  int Map(const std::string& path) {
+    Reset();
+    const int fd = open(path.c_str(), O_RDONLY | O_CLOEXEC);
+    if (fd < 0) return -errno;
+    struct stat st;
+    int rc = 0;
+    if (fstat(fd, &st) != 0) {
+      rc = -errno;
+    } else if (st.st_size <= 0) {
+      rc = -EINVAL;
+    } else {
+      void* p = mmap(nullptr, static_cast<size_t>(st.st_size), PROT_READ,
+                     MAP_PRIVATE, fd, 0);
+      if (p == MAP_FAILED) {
+        rc = -errno;
+      } else {
+        data_ = p;
+        size_ = static_cast<size_t>(st.st_size);
+      }
+    }
+    close(fd);
+    return rc;
+  }
+
+  // Drops the resident pages (they are re-read from the file if touched
+  // again), so a restored network does not keep the file in this process's
+  // RSS/PSS. The mapping itself stays valid.
+  void ReleasePages() {
+    if (data_ != nullptr) madvise(data_, size_, MADV_DONTNEED);
+  }
+
+  void Reset() {
+    if (data_ != nullptr) munmap(data_, size_);
+    data_ = nullptr;
+    size_ = 0;
+  }
+
+  const void* data() const { return data_; }
+  size_t size() const { return size_; }
+
+ private:
+  void* data_ = nullptr;
+  size_t size_ = 0;
+};
+
+inline long long NpusttNowMs() {
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return static_cast<long long>(ts.tv_sec) * 1000 + ts.tv_nsec / 1000000;
+}
+
+}  // namespace neuron
+}  // namespace tflite
+
+#endif  // NEURON_NPUSTT_DLA_CACHE_H_
