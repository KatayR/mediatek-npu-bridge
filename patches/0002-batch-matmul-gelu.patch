diff --git a/neuron/neuron_delegate_builder.h b/neuron/neuron_delegate_builder.h
index 7df3937..48f658f 100644
--- a/neuron/neuron_delegate_builder.h
+++ b/neuron/neuron_delegate_builder.h
@@ -178,6 +178,10 @@ class NeuronOpBuilder {
     return AddScalarOperand<int32_t>(value, NEURON_INT32);
   }
 
+  TfLiteStatus AddScalarUInt32Operand(uint32_t value) {
+    return AddScalarOperand<uint32_t>(value, NEURON_UINT32);
+  }
+
   TfLiteStatus AddScalarFloat32Operand(float value) {
