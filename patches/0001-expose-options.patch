 #include "neuron/neuron_delegate.h"
 
 #define TAG "NeuronDelegateJni"
 
+namespace {
+
+// NeuronDelegateOptions keeps cache_dir and model_token as raw pointers, and
+// the delegate copies only the pointers. The strings are duplicated here and
+// freed when the delegate is deleted.
+std::mutex g_owned_mutex;
+std::map<TfLiteDelegate*, std::pair<char*, char*>> g_owned_strings;
+
+void ThrowIllegalArgument(JNIEnv* env, const char* message) {
+  jclass cls = env->FindClass("java/lang/IllegalArgumentException");
+  if (cls != nullptr) {
+    env->ThrowNew(cls, message);
+  }
+}
+
+// Copies a Java string into a fixed-size, NUL-terminated char array. A null
+// string leaves `dst` unchanged. Returns false with a pending Java exception
+// if the string cannot be read or does not fit.
+bool CopyJString(JNIEnv* env, jstring s, char* dst, size_t cap,
+                 const char* what) {
+  if (s == nullptr) {
+    return true;
+  }
+  const char* chars = env->GetStringUTFChars(s, nullptr);
+  if (chars == nullptr) {
+    return false;  // OutOfMemoryError is pending.
+  }
+  const int n = snprintf(dst, cap, "%s", chars);
+  env->ReleaseStringUTFChars(s, chars);
+  if (n < 0 || static_cast<size_t>(n) >= cap) {
+    char message[96];
+    snprintf(message, sizeof(message), "%s is longer than %zu bytes", what,
+             cap - 1);
+    ThrowIllegalArgument(env, message);
+    return false;
+  }
+  return true;
+}
+
+// Returns a strdup'ed copy to be released with free(), or nullptr for a null
+// or empty string. Sets *ok to false (with a pending Java exception) on error.
+char* DupJString(JNIEnv* env, jstring s, bool* ok) {
+  *ok = true;
+  if (s == nullptr) {
+    return nullptr;
+  }
+  const char* chars = env->GetStringUTFChars(s, nullptr);
+  if (chars == nullptr) {
+    *ok = false;  // OutOfMemoryError is pending.
+    return nullptr;
+  }
+  char* copy = chars[0] != '\0' ? strdup(chars) : nullptr;
+  const bool failed = chars[0] != '\0' && copy == nullptr;
+  env->ReleaseStringUTFChars(s, chars);
+  if (failed) {
+    jclass cls = env->FindClass("java/lang/OutOfMemoryError");
+    if (cls != nullptr) {
+      env->ThrowNew(cls, "strdup failed");
+    }
+    *ok = false;
+  }
+  return copy;
+}
+
+}  // namespace
